# Python cache (safe to ignore)
__pycache__/
**/__pycache__/
*.pyc

# Big raw videos (you mount these at runtime)
**/*.mp4
# ...except curated test fixtures used by post_install_check.sh
!container_payload_20260507/samples/*.mp4

# Pre-regen backup directories
container_payload_20260507.pre-regen-*/
container_payload_20260507.pre-claude-backup/

# Host virtualenvs – Docker recreates these
container_payload_20260507/auto_avsr/pre-process-venv
container_payload_20260507/pre-process-venv
container_payload_20260507/vsp-llm-yoad-venv
